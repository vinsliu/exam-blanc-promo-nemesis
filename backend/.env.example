MONGO_URI=mongodb://localhost:27017/exam_practice_db

# Générez un secret long et aléatoire, ex: `openssl rand -hex 64`.
# Ne jamais committer la vraie valeur (le fichier .env est ignoré par git).
JWT_SECRET=change_me_with_a_long_random_secret

# Origine(s) autorisée(s) pour le CORS, séparées par des virgules.
CORS_ORIGIN=http://localhost:3000

# Optionnel : active GET /api/logs (consultation des logs sans accès au
# dashboard d'hébergement), protégé par ce token en header `x-logs-token`
# ou paramètre `?token=`. Laissez vide/absent pour désactiver la route.
# Générez-en un avec `openssl rand -hex 32`.
LOGS_ACCESS_TOKEN=
