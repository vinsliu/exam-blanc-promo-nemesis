# Variables lues par docker-compose.yml (copier en ".env" à la racine,
# à côté de docker-compose.yml — docker-compose le charge automatiquement).
# Ne pas confondre avec backend/.env.example, utilisé pour le lancement
# "classique" (npm start / npm run dev) hors Docker.

# Générez un secret long et aléatoire, ex: `openssl rand -hex 64`.
JWT_SECRET=change_me_with_a_long_random_secret

# Origine autorisée en CORS côté backend.
CORS_ORIGIN=http://localhost:3000

# URL de l'API telle qu'appelée depuis le navigateur de l'utilisateur
# (pas depuis l'intérieur des conteneurs) : injectée au build du frontend.
REACT_APP_API_URL=http://localhost:5000/api
